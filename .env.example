# Sao chép thành .env (đã gitignore). Không commit key thật.
# Server/script (FastAPI, scripts/sync_supabase.py, scripts/seed_demo_users.py)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Mật khẩu tài khoản demo (configs/demo_users.yaml); để trống → script sinh mật khẩu tạm
DEMO_PW_ADMIN01=
DEMO_PW_DEMO01=
DEMO_PW_DEMO02=
DEMO_PW_DEMO03=

# Frontend React (web/.env.local): chỉ anon key, không bao giờ service_role
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
# VITE_API_URL=http://localhost:8000
