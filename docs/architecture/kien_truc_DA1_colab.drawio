<mxfile host="app.diagrams.net" type="device" version="24.7.17"><diagram id="1._Kiến_trúc_triển_k" name="1. Kiến trúc triển khai"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="970" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="t1" value="Kiến trúc ĐA1: phát triển trên WSL, chạy GPU theo lô trên Google Colab (Pay As You Go)" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=20;fontColor=#1a1a1a;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="56" y="18" width="1700" height="32" as="geometry" /></mxCell><mxCell id="t2" value="Code đi qua GitHub, dữ liệu và kết quả đi qua Google Drive; mọi bước cần GPU (embed, rerank, sinh câu trả lời, demo) chạy trên Colab với cùng một bộ code src/." style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="56" y="52" width="1700" height="24" as="geometry" /></mxCell><mxCell id="b3" value="&lt;b&gt;Tài liệu công khai&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;website DN bảo hiểm,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;cổng văn bản pháp luật&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="300" width="200" height="72" as="geometry" /></mxCell><mxCell id="b4" value="&lt;b&gt;Gemini API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;soạn nháp benchmark,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;judge cho Ragas&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="56" y="560" width="200" height="72" as="geometry" /></mxCell><mxCell id="z5" value="&lt;b&gt;Máy WSL2 · laptop CPU 8 nhân, 12 GB RAM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;phát triển hằng ngày, điều phối, phân tích&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f3f7fd;strokeColor=#6c8ebf;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="400" height="580" as="geometry" /></mxCell><mxCell id="b6" value="&lt;b&gt;Code, config, benchmark&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;src/, configs/B0–B4, benchmark_v1.jsonl (dev 30 / test 120)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="314" y="170" width="352" height="72" as="geometry" /></mxCell><mxCell id="b7" value="&lt;b&gt;Xây kho tri thức (CPU)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Docling + OCR → chunk theo Điều/Khoản → metadata,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;catalog, từ điển 2 cấp&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="314" y="300" width="352" height="72" as="geometry" /></mxCell><mxCell id="b8" value="&lt;b&gt;Qdrant v1.20.0 (Docker)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;index dev để debug truy xuất, không dùng cho số liệu báo cáo&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="314" y="430" width="352" height="72" as="geometry" /></mxCell><mxCell id="b9" value="&lt;b&gt;Đánh giá và phân tích&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Recall@k, MRR, trích dẫn, từ chối (từ log) · Ragas ·&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;tinh chỉnh ngưỡng trên dev, phân tích lỗi → results/&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="314" y="560" width="352" height="92" as="geometry" /></mxCell><mxCell id="b10" value="&lt;b&gt;GitHub · repo public bv-rag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;nguồn code duy nhất cho cả WSL và Colab&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="740" y="170" width="360" height="72" as="geometry" /></mxCell><mxCell id="z11" value="&lt;b&gt;Google Drive · MyDrive/bv-rag&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;kho trao đổi artifact; đồng bộ với WSL bằng rclone&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f2f8f1;strokeColor=#82b366;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="740" y="280" width="360" height="410" as="geometry" /></mxCell><mxCell id="b12" value="&lt;b&gt;processed/vN/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;chunks.jsonl, catalog.json, glossary.json&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="764" y="330" width="312" height="64" as="geometry" /></mxCell><mxCell id="b13" value="&lt;b&gt;vectors/vN/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;dense.npy, sparse.jsonl, chunk_ids&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="764" y="450" width="312" height="64" as="geometry" /></mxCell><mxCell id="b14" value="&lt;b&gt;runs/{run_id}/&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;log JSONL (retrieved, rerank, citations,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;latency, tokens), meta.json (GPU, digest)&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="764" y="570" width="312" height="82" as="geometry" /></mxCell><mxCell id="z15" value="&lt;b&gt;Google Colab · Pay As You Go · GPU NVIDIA L4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;phiên tạm: đầu ra luôn ghi về Drive, model tải lại mỗi phiên; mọi lần chạy chính thức B0–B4 dùng L4&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff7ee;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1150" y="110" width="660" height="580" as="geometry" /></mxCell><mxCell id="b16" value="&lt;b&gt;Notebook scripts/colab_batch.ipynb&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;clone repo public · pip install · mount Drive · ollama serve · nạp Qwen + warm-up · chọn job&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="1174" y="170" width="612" height="72" as="geometry" /></mxCell><mxCell id="b17" value="&lt;b&gt;Job 1 · Embed tài liệu&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;bge-m3 fp16, dense + sparse&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="1174" y="300" width="290" height="72" as="geometry" /></mxCell><mxCell id="b18" value="&lt;b&gt;Job 2 · Chạy cấu hình B0–B4&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;RAGPipeline(config) end-to-end&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;trên dev hoặc test&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="1174" y="430" width="290" height="92" as="geometry" /></mxCell><mxCell id="b19" value="&lt;b&gt;Job 3 · Demo (khi bảo vệ)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;FastAPI + Streamlit, tunnel cloudflared&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="1174" y="580" width="290" height="72" as="geometry" /></mxCell><mxCell id="z20" value="&lt;b&gt;Mô hình và chỉ mục&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;nạp mỗi phiên&lt;/font&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff7ee;strokeColor=#d79b00;verticalAlign=top;align=left;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=13;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1500" y="290" width="286" height="372" as="geometry" /></mxCell><mxCell id="b21" value="&lt;b&gt;bge-m3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;embed tài liệu và câu hỏi&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="1514" y="346" width="258" height="58" as="geometry" /></mxCell><mxCell id="b22" value="&lt;b&gt;Qdrant local mode&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;nạp từ vectors/vN, hybrid RRF&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="1514" y="418" width="258" height="58" as="geometry" /></mxCell><mxCell id="b23" value="&lt;b&gt;bge-reranker-v2-m3&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;điểm rerank ghi vào log&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="1514" y="490" width="258" height="58" as="geometry" /></mxCell><mxCell id="b24" value="&lt;b&gt;Qwen2.5 7B q4_K_M&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;Ollama, nạp trước PyTorch,&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;num_gpu 99, keep_alive −1&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontColor=#1a1a1a;spacing=6;" vertex="1" parent="1"><mxGeometry x="1514" y="562" width="258" height="82" as="geometry" /></mxCell><mxCell id="b25" value="&lt;b&gt;Hội đồng / người dùng&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#555555&quot;&gt;trình duyệt → URL tunnel&lt;/font&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffffff;st