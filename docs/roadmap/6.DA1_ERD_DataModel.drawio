<mxCell id="e21" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endFill=0;startFill=0;strokeColor=#555555;startArrow=ERzeroToMany;endArrow=ERmandOne;" edge="1" parent="1" source="chunks__data_version" target="data_versions__version"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endFill=0;startFill=0;strokeColor=#555555;startArrow=ERzeroToMany;endArrow=ERmandOne;" edge="1" parent="1" source="documents__product_code" target="products__product_code"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endFill=0;startFill=0;strokeColor=#555555;startArrow=ERzeroToMany;endArrow=ERmandOne;" edge="1" parent="1" source="runs__config_name" target="pipeline_configs__name"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="" style="edgeStyle=entityRelationEdgeStyle;html=1;rounded=0;endFill=0;startFill=0;strokeColor=#555555;startArrow=ERzeroToMany;endArrow=ERmandOne;" edge="1" parent="1" source="eval_results__run_id" target="runs__run_id"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c25" value="&lt;b&gt;Chú thích&lt;/b&gt;" style="text;html=1;align=left;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="740" width="200" height="22" as="geometry" /></mxCell><mxCell id="c26" value="" style="rounded=0;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1700" y="768" width="40" height="22" as="geometry" /></mxCell><mxCell id="c27" value="Bắt buộc (phục vụ UC ưu tiên 1, log bắt buộc)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1750" y="768" width="330" height="22" as="geometry" /></mxCell><mxCell id="c28" value="" style="rounded=0;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1700" y="798" width="40" height="22" as="geometry" /></mxCell><mxCell id="c29" value="Nên có (UC ưu tiên 2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1750" y="798" width="330" height="22" as="geometry" /></mxCell><mxCell id="c30" value="" style="rounded=0;html=1;fillColor=#FFFFFF;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="1700" y="828" width="40" height="22" as="geometry" /></mxCell><mxCell id="c31" value="Tùy chọn (UC ưu tiên 3)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1750" y="828" width="330" height="22" as="geometry" /></mxCell><mxCell id="c32" value="" style="rounded=0;html=1;fillColor=#E6E6E6;strokeColor=#808080;" vertex="1" parent="1"><mxGeometry x="1700" y="858" width="40" height="22" as="geometry" /></mxCell><mxCell id="c33" value="Supabase quản lý (schema auth)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1750" y="858" width="330" height="22" as="geometry" /></mxCell><mxCell id="c34" value="" style="rounded=0;html=1;fillColor=#F5F5F5;strokeColor=#B3B3B3;dashed=1;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1700" y="888" width="40" height="22" as="geometry" /></mxCell><mxCell id="c35" value="Mở rộng ĐA2/ĐATN – chưa tạo ở ĐA1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1750" y="888" width="330" height="22" as="geometry" /></mxCell><mxCell id="c36" value="FK không vẽ để tránh rối: runs.data_version → data_versions; app_settings.updated_by → profiles; data_version trong message_citations / retrieval_logs là một phần FK ghép (data_version, chunk_id) → chunks." style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#999999;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1700" y="920" width="640" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="3. Ánh xạ UC và ghi chú Supabase" id="notes"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c0" value="Ánh xạ use case → bảng và ghi chú triển khai Supabase" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1800" height="30" as="geometry" /></mxCell><mxCell id="c1" value="&lt;b&gt;Ánh xạ UC → bảng&lt;/b&gt;&lt;br&gt;&lt;table style=&quot;border-collapse:collapse;font-size:11px;margin-top:6px&quot;&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-AUTH-01, 02, 04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;auth.users, profiles – Supabase Auth, đăng nhập bằng email; AUTH-04 = đếm 30 phút không thao tác ở giao diện + refresh token&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-AUTH-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;profiles.role + RLS (is_admin()) + require_admin ở FastAPI&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;conversations, messages (user + assistant), traces, retrieval_logs, runs&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;messages.product_filter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-03, 10, 12; HIS-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;Không lưu (xử lý ở giao diện)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;message_citations → chunks → documents (view v_message_sources)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;documents.url&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-06&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;messages.refused, refusal_reason&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-07&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;sample_questions&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-08&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;conversations&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-09&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;feedback&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-11&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;messages.content (che trước khi insert), pii_masked&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-CHAT-13&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;v_catalog: products, documents, chunks, data_versions (mọi người dùng; thay UC-ADM-02)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-HIS-01, 02&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;v_conversation_list, messages, v_message_sources (snapshot, không chạy lại pipeline)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-HIS-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;pg_trgm GIN trên messages.content&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-HIS-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;conversations.title, title_is_custom&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-HIS-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;DELETE conversations → ON DELETE CASCADE&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-SET-01, 02, 05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;user_settings (gồm language, show_processing)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-SET-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;pipeline_configs, app_settings (active_config)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-SET-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;Không lưu vào hội thoại; chỉ log.jsonl của 2 run&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-SET-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;traces, retrieval_logs (chỉ admin)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-ADM-01&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;auth.users (admin API), profiles&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-ADM-03&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;v_query_logs (messages, traces, retrieval_logs, feedback, runs)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-ADM-04&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;demo_metrics() + eval_results&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px;white-space:nowrap&quot;&gt;&lt;b&gt;UC-ADM-05&lt;/b&gt;&lt;/td&gt;&lt;td style=&quot;border:1px solid #ccc;padding:3px 6px&quot;&gt;Không lưu (/admin/health; /health công khai)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="760" height="760" as="geometry" /></mxCell><mxCell id="c2" value="&lt;b&gt;Nguyên tắc dữ liệu&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Nguồn sự thật vẫn là file: chunks.jsonl, catalog.json, sources.csv, configs/*.yaml, benchmark. Nhóm C và pipeline_configs là bản sao, đồng bộ một chiều bằng script.&lt;/li&gt;&lt;li&gt;Pipeline và eval (B0–B4) không đọc DB → số liệu báo cáo không phụ thuộc Supabase.&lt;/li&gt;&lt;li&gt;Vector vẫn ở Qdrant (bge-m3 dense + sparse); không dùng pgvector.&lt;/li&gt;&lt;li&gt;Log: FastAPI vẫn ghi runs/{run_id}/log.jsonl theo quy ước; traces + retrieval_logs là bản cho giao diện. Xóa hội thoại (HIS-05) không xóa log.jsonl.&lt;/li&gt;&lt;li&gt;run_id phiên demo: {config}_demo_{yyyymmdd-hhmm}, split = demo, benchmark = null; đổi cấu hình → run mới.&lt;/li&gt;&lt;li&gt;Supabase cloud (region Singapore) chỉ chứa tài khoản demo, tài liệu công khai, nội dung đã che TTCN. Dữ liệu thật ĐA2/ĐATN: cùng migrations, chạy Supabase local trên WSL.&lt;/li&gt;&lt;/ul&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#999999;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="60" width="920" height="250" as="geometry" /></mxCell><mxCell id="c3" value="&lt;b&gt;Xác thực và RLS&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;Supabase Auth, email giả demoNN@bv-rag.local; tắt sign-up và xác nhận email; tạo user bằng admin API.&lt;/li&gt;&lt;li&gt;Web React (thiết kế Figma) gọi Supabase trực tiếp bằng anon key + JWT người dùng (RLS có hiệu lực) cho tài khoản, lịch sử, cài đặt, danh mục; service_role key chỉ nằm ở FastAPI và script (.env, không commit).&lt;/li&gt;&lt;li&gt;FastAPI xác thực JWT; ghi conversations (tạo), messages, message_citations, traces, retrieval_logs, runs, app_settings bằng service_role; tạo/khóa tài khoản qua admin API.&lt;/li&gt;&lt;li&gt;Hàm is_admin() (security definer, đọc profiles.role).&lt;/li&gt;&lt;li&gt;user_settings, feedback: chủ sở hữu đọc/ghi. conversations: chủ sở hữu đọc, đổi tên (GRANT theo cột title, title_is_custom), xóa. messages, message_citations: chủ sở hữu chỉ đọc (chống tự chèn câu trả lời/trích dẫn). Admin đọc tất cả.&lt;/li&gt;&lt;li&gt;Chi tiết quyền theo bảng: sheet RLS trong 5.DA1_DataDictionary.xlsx.&lt;/li&gt;&lt;li&gt;products, documents, data_versions, chunks, sample_questions, pipeline_configs: authenticated chỉ đọc.&lt;/li&gt;&lt;li&gt;traces, retrieval_logs, runs, eval_results, app_settings: chỉ admin đọc.&lt;/li&gt;&lt;/ul&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#999999;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="330" width="920" height="300" as="geometry" /></mxCell><mxCell id="c4" value="&lt;b&gt;Kiểu enum, index, migration&lt;/b&gt;&lt;ul style=&quot;margin:4px 0 0 0;padding-left:16px&quot;&gt;&lt;li&gt;user_role: user | admin. msg_role: user | assistant (ĐA2 thêm tool). feedback_reason: sai_noi_dung | thieu_nguon | trich_dan_sai | tu_choi_nham | khac.&lt;/li&gt;&lt;li&gt;doc_type: quy_tac | dieu_khoan | bang_phi | bang_quyen_loi | brochure | faq (theo quy ước chung). theme_mode: light | dark | system. citation_style: inline | footnote. ui_language: vi | en.&lt;/li&gt;&lt;li&gt;Index: conversations(user_id, updated_at desc); messages(conversation_id, created_at); messages(reply_to_id); GIN pg_trgm messages.content; feedback(rating); chunks(document_id).&lt;/li&gt;&lt;li&gt;updated_at cập nhật bằng trigger; uuid default gen_random_uuid(); thời gian dùng timestamptz.&lt;/li&gt;&lt;li&gt;View (security_invoker): v_conversation_list, v_message_sources, v_catalog, v_query_logs. RPC: search_conversations(), demo_metrics(). Trigger: touch_conversation, default_settings.&lt;/li&gt;&lt;li&gt;Migration: supabase/migrations/*.sql (Supabase CLI); seed tài khoản demo + đồng bộ nhóm C bằng script trong scripts/.&lt;/li&gt;&lt;/ul&gt;" style="shape=note;whiteSpace=wrap;html=1;size=14;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=11;fillColor=#FFFFFF;strokeColor=#999999;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="820" y="650" width="920" height="290" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>